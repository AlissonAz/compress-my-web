<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CompressMyWeb.ViewModels" xmlns:models="using:CompressMyWeb.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760" x:Class="CompressMyWeb.Views.MainWindow"
        x:DataType="vm:MainViewModel" Icon="/Assets/favcon CmW.png"
        Title="Compress my Web — Compressão de arquivos" Width="1100" Height="760" MinWidth="900" MinHeight="650"
        CanResize="True"
        WindowStartupLocation="CenterScreen" Background="#F4F7F4" Foreground="#171A17">
    <Window.Resources>
        <SolidColorBrush x:Key="BrandGreenDark">#008F1F</SolidColorBrush>
        <SolidColorBrush x:Key="BrandGreenSoft">#E8F8EC</SolidColorBrush>
        <SolidColorBrush x:Key="BrandText">#171A17</SolidColorBrush>
        <SolidColorBrush x:Key="BrandMutedText">#5E685F</SolidColorBrush>
        <SolidColorBrush x:Key="BrandSurface">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="BrandSurfaceMuted">#F1F5F1</SolidColorBrush>
        <SolidColorBrush x:Key="BrandBorder">#D5E1D7</SolidColorBrush>
        <SolidColorBrush x:Key="BrandDanger">#C93636</SolidColorBrush>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource BrandText}"/></Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="#000000"/><Setter Property="Background" Value="#D4D0C8"/>
            <Setter Property="BorderBrush" Value="#808080"/>
        </Style>
        <Style Selector="Button.preset"><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="12,7"/><Setter Property="CornerRadius" Value="6"/></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BrandSurface}"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/><Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBox, ComboBox, NumericUpDown">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{DynamicResource BrandText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandBorder}"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- TELA INICIAL -->
        <Grid IsVisible="{Binding IsHome}" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
            <Border Classes="card" Padding="42" Background="{DynamicResource BrandSurface}">
                <StackPanel Spacing="28">
                    <StackPanel HorizontalAlignment="Center" Spacing="10">
                        <Border Width="110" Height="110" CornerRadius="24" Background="{DynamicResource BrandGreenSoft}" Padding="12">
                            <Image Source="/Assets/favcon CmW.png" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Compress my Web" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Ferramentas locais para imagens e PDFs" FontSize="15" Foreground="{DynamicResource BrandMutedText}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <UniformGrid Columns="2" Rows="2" Width="668" HorizontalAlignment="Center">
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="Compress" Width="320" Height="180" Margin="7" Padding="18" CornerRadius="12">
                            <StackPanel Spacing="8" VerticalAlignment="Center">
                                <Canvas Width="64" Height="52" HorizontalAlignment="Center">
                                    <Border Canvas.Left="12" Canvas.Top="8" Width="32" Height="39" CornerRadius="3" Background="#FFFFFF" BorderBrush="#008F1F" BorderThickness="2"/>
                                    <Border Canvas.Left="19" Canvas.Top="3" Width="32" Height="39" CornerRadius="3" Background="#E8F8EC" BorderBrush="#008F1F" BorderThickness="2"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="0" Text="↘" FontSize="20" FontWeight="Bold" Foreground="#008F1F"/>
                                    <TextBlock Canvas.Left="43" Canvas.Top="0" Text="↙" FontSize="20" FontWeight="Bold" Foreground="#008F1F"/>
                                    <TextBlock Canvas.Left="0" Canvas.Top="27" Text="↗" FontSize="20" FontWeight="Bold" Foreground="#008F1F"/>
                                    <TextBlock Canvas.Left="43" Canvas.Top="27" Text="↖" FontSize="20" FontWeight="Bold" Foreground="#008F1F"/>
                                </Canvas>
                                <TextBlock Text="Comprimir" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Reduza o tamanho de imagens e PDFs" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="Convert" Width="320" Height="180" Margin="7" Padding="18" CornerRadius="12">
                            <StackPanel Spacing="8" VerticalAlignment="Center"><Border Height="52"><TextBlock Text="🔄" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Converter" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Altere o formato dos seus arquivos" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="MergePdf" Width="320" Height="180" Margin="7" Padding="18" CornerRadius="12">
                            <StackPanel Spacing="8" VerticalAlignment="Center"><Border Height="52"><TextBlock Text="📑" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Unir PDF" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Junte vários PDFs em um só arquivo" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                        </Button>
                        <Button Command="{Binding NavigateToCommand}" CommandParameter="SplitPdf" Width="320" Height="180" Margin="7" Padding="18" CornerRadius="12">
                            <StackPanel Spacing="8" VerticalAlignment="Center"><Border Height="52"><TextBlock Text="✂️" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Dividir PDF" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Separe páginas ou intervalos de um PDF" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
                        </Button>
                    </UniformGrid>
                    <TextBlock Text="Seus arquivos são processados no seu computador." HorizontalAlignment="Center" Foreground="{DynamicResource BrandMutedText}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- UNIR PDF -->
        <Grid IsVisible="{Binding IsMergePage}" RowDefinitions="Auto,Auto,*,Auto" Margin="24">
            <Border Grid.Row="0" Classes="card" Background="{DynamicResource BrandGreenSoft}" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Content="← Início" Command="{Binding GoHomeCommand}" IsEnabled="{Binding !IsMerging}" VerticalAlignment="Center" Padding="12,7"/>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="Unir PDF" FontSize="23" FontWeight="Bold"/>
                        <TextBlock Text="Organize os arquivos na ordem em que as páginas devem aparecer." FontSize="13" Foreground="{DynamicResource BrandMutedText}"/>
                    </StackPanel>
                    <Image Grid.Column="2" Source="/Assets/favcon CmW.png" Width="48" Height="48" Stretch="Uniform"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="card" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    <Button Content="➕ Adicionar PDFs" Command="{Binding AddMergeFilesCommand}" IsEnabled="{Binding !IsMerging}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding MergeItems.Count, StringFormat='{}{0} arquivo(s)'}" VerticalAlignment="Center" Foreground="{DynamicResource BrandMutedText}"/>
                    <Button Grid.Column="3" Content="🗑 Remover todos" Command="{Binding ClearMergeItemsCommand}" IsEnabled="{Binding !IsMerging}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Classes="card" Margin="0,0,0,12">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="{DynamicResource BrandSurfaceMuted}" CornerRadius="6" Padding="10,7">
                        <Grid ColumnDefinitions="50,*,110,150"><TextBlock Text="#" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Arquivo" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Tamanho" FontWeight="SemiBold" HorizontalAlignment="Center"/></Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <StackPanel IsVisible="{Binding MergeIsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="📑" FontSize="38" HorizontalAlignment="Center"/>
                            <TextBlock Text="Adicione dois ou mais PDFs para começar" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding MergeItems}" IsVisible="{Binding MergeHasItems}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate DataType="models:PdfMergeItem">
                                <Border Margin="0,2" Padding="10,8" CornerRadius="6" Background="{DynamicResource BrandSurfaceMuted}">
                                    <Grid ColumnDefinitions="50,*,110,150">
                                        <TextBlock Text="PDF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                            <Button Content="↑" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveMergeItemUpCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="↓" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).MoveMergeItemDownCommand}" CommandParameter="{Binding}"/>
                                            <Button Content="✕" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveMergeItemCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="3" Classes="card">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="Destino" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding MergeOutputDirectory}" IsReadOnly="True" FontSize="12"/>
                    <Button Grid.Column="2" Content="📂 Alterar pasta" Command="{Binding SelectMergeOutputFolderCommand}" IsEnabled="{Binding !IsMerging}" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" Content="↗ Abrir" Command="{Binding OpenMergeOutputFolderCommand}" Margin="8,0,0,0"/>
                    <TextBlock Grid.Row="1" Text="Nome" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,12,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MergeOutputFileName}" Watermark="Nome do PDF final" Margin="0,10,0,0" IsEnabled="{Binding !IsMerging}"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="📑 Unir PDFs" Command="{Binding MergePdfsCommand}" IsEnabled="{Binding CanMerge}" IsVisible="{Binding !IsMerging}" FontWeight="Bold" Margin="8,10,0,0" Padding="18,10"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="⏳ Unindo PDFs... (cancelar)" Command="{Binding CancelMergeCommand}" IsVisible="{Binding IsMerging}" FontWeight="Bold" Margin="8,10,0,0" Padding="18,10"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Text="{Binding MergeStatusMessage}" Foreground="{DynamicResource BrandMutedText}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- DIVIDIR PDF -->
        <Grid IsVisible="{Binding IsFeaturePlaceholder}" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
            <Border Classes="card" Padding="36">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Content="← Início" Command="{Binding GoHomeCommand}" IsEnabled="{Binding !IsSplitting}" VerticalAlignment="Center" Padding="12,7"/>
                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="Dividir PDF" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="Crie um PDF separado para cada página." FontSize="13" Foreground="{DynamicResource BrandMutedText}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="✂️" FontSize="34" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource BrandSurfaceMuted}" CornerRadius="8" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel>
                                <TextBlock Text="PDF de origem" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SplitInputPath}" IsVisible="{Binding CanSplit}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrandMutedText}" Margin="0,4,0,0"/>
                                <TextBlock Text="Nenhum arquivo selecionado" IsVisible="{Binding !CanSplit}" Foreground="{DynamicResource BrandMutedText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📄 Selecionar PDF" Command="{Binding SelectSplitFileCommand}" IsEnabled="{Binding !IsSplitting}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <Grid ColumnDefinitions="Auto,260,*">
                            <TextBlock Text="Modo" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SplitModes}" SelectedValue="{Binding SplitMode}" SelectedValueBinding="{Binding Value}" IsEnabled="{Binding !IsSplitting}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="2" Text="Escolha como as páginas serão agrupadas." VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource BrandMutedText}"/>
                        </Grid>
                        <StackPanel IsVisible="{Binding IsSplitByRanges}" Spacing="4">
                            <TextBlock Text="Intervalos" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding SplitRanges}" Watermark="Ex.: 1-3,5,8-10" IsEnabled="{Binding !IsSplitting}"/>
                            <TextBlock Text="Use vírgulas para separar os grupos. Cada grupo cria um PDF; páginas repetidas não são aceitas." FontSize="12" Foreground="{DynamicResource BrandMutedText}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Text="Arquivos de saída" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Text="Pasta" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SplitOutputDirectory}" IsReadOnly="True" FontSize="12"/>
                            <Button Grid.Column="2" Content="📂 Alterar" Command="{Binding SelectSplitOutputFolderCommand}" IsEnabled="{Binding !IsSplitting}" Margin="8,0,0,0"/>
                            <Button Grid.Column="3" Content="↗ Abrir" Command="{Binding OpenSplitOutputFolderCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Text="Prefixo" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding SplitOutputPrefix}" Watermark="Ex.: contrato-pagina" IsEnabled="{Binding !IsSplitting}"/>
                        </Grid>
                        <TextBlock Text="Exemplo: contrato-pagina-1.pdf, contrato-pagina-2.pdf" IsVisible="{Binding !IsSplitByRanges}" FontSize="12" Foreground="{DynamicResource BrandMutedText}"/>
                        <TextBlock Text="Exemplo: contrato-pagina-parte-1-3.pdf, contrato-pagina-parte-5.pdf" IsVisible="{Binding IsSplitByRanges}" FontSize="12" Foreground="{DynamicResource BrandMutedText}"/>
                    </StackPanel>

                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SplitStatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource BrandMutedText}" TextWrapping="Wrap" Margin="0,0,14,0"/>
                        <Button Grid.Column="1" Content="✂️ Dividir PDF" Command="{Binding SplitPdfCommand}" IsEnabled="{Binding CanSplit}" IsVisible="{Binding !IsSplitting}" FontWeight="Bold" Padding="18,10"/>
                        <Button Grid.Column="1" Content="⏳ Dividindo PDF... (cancelar)" Command="{Binding CancelSplitCommand}" IsVisible="{Binding IsSplitting}" FontWeight="Bold" Padding="18,10"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- COMPRESSÃO E CONVERSÃO -->
        <Grid IsVisible="{Binding IsWorkspace}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="16">
        <!-- IDENTIDADE -->
        <Border Grid.Row="0" Classes="card" Background="{DynamicResource BrandGreenSoft}" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Content="← Início" Command="{Binding GoHomeCommand}" VerticalAlignment="Center" Padding="12,7" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Width="48" Height="48" CornerRadius="10" Background="White" Padding="4">
                        <Image Source="/Assets/favcon CmW.png" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Compress my Web" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="Compressão de arquivos" FontSize="13" Foreground="{DynamicResource BrandMutedText}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="{Binding PageTitle}" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Processamento local, sem envio para servidores" FontSize="13" Foreground="{DynamicResource BrandMutedText}"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Sobre" VerticalAlignment="Center" Padding="16,7" Click="AboutButton_OnClick"/>
            </Grid>
        </Border>

        <!-- PRESETS -->
        <Border Grid.Row="1" Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Presets" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="preset" Content="🌐 Web Ideal (80%)" Command="{Binding ApplyPresetCommand}" CommandParameter="Web" ToolTip.Tip="Padrão: 80%, mantendo a resolução original"/>
                    <Button Classes="preset" Content="💎 Alta Qualidade (90%)" Command="{Binding ApplyPresetCommand}" CommandParameter="HighQuality"/>
                    <Button Classes="preset" Content="🎯 Sem Perdas / Não comprimir" Command="{Binding ApplyPresetCommand}" CommandParameter="Lossless"/>
                    <Button Classes="preset" Content="📦 Máx. Compressão (60%)" Command="{Binding ApplyPresetCommand}" CommandParameter="MaxCompression"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FORMATO DE SAÍDA -->
        <Border Grid.Row="2" Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,260,*,Auto">
                <TextBlock Text="Formato de saída" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding OutputFormats}" SelectedValue="{Binding Settings.OutputFormat}"
                          SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Column="2" Text="PDF de entrada: somente compressão para outro PDF."
                           IsVisible="{Binding Settings.IsPdfOutput}" FontSize="12"
                           Foreground="{DynamicResource BrandMutedText}" VerticalAlignment="Center" Margin="14,0"/>
                <Button Grid.Column="3" Content="⚙ Opções" Command="{Binding ToggleAdvancedSettingsCommand}"/>
            </Grid>
        </Border>

        <!-- DESTINO -->
        <Border Grid.Row="3" Classes="card" Margin="0,0,0,10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBlock Text="Pasta de destino" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBox Grid.Column="1" Text="{Binding Settings.OutputDirectory}" IsReadOnly="True" FontSize="12"/>
                <Button Grid.Column="2" Content="📂 Alterar Pasta" Command="{Binding SelectOutputFolderCommand}" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Content="↗ Abrir Pasta" Command="{Binding OpenOutputFolderCommand}" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- OPÇÕES -->
        <Border Grid.Row="4" Classes="card" IsVisible="{Binding ShowAdvancedSettings}" Margin="0,0,0,10" Background="{DynamicResource BrandSurfaceMuted}">
            <Grid ColumnDefinitions="1.1*,1.3*,1.3*,1.2*">
                <StackPanel Spacing="5" Margin="0,0,16,0">
                    <TextBlock Text="Qualidade" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Slider Minimum="1" Maximum="100" Value="{Binding Settings.Quality}" IsEnabled="{Binding Settings.SupportsQuality}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Settings.Quality, StringFormat='{}{0}%'}" FontWeight="Bold" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox IsChecked="{Binding Settings.IsLossless}" Content="WebP sem perdas" IsEnabled="{Binding Settings.IsWebpOutput}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5" Margin="0,0,16,0">
                    <TextBlock Text="Redimensionamento" FontWeight="SemiBold"/><CheckBox IsChecked="{Binding Settings.EnableResize}" Content="Limitar resolução"/>
                    <Grid ColumnDefinitions="*,8,*" IsEnabled="{Binding Settings.EnableResize}">
                        <NumericUpDown Value="{Binding Settings.MaxWidth}" Minimum="100" Maximum="10000" FormatString="F0"/>
                        <NumericUpDown Grid.Column="2" Value="{Binding Settings.MaxHeight}" Minimum="100" Maximum="10000" FormatString="F0"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5" Margin="0,0,16,0">
                    <TextBlock Text="Arquivos" FontWeight="SemiBold"/><TextBox Text="{Binding Settings.FileSuffix}" Watermark="Sufixo: _otimizada"/>
                    <CheckBox IsChecked="{Binding Settings.PreserveFolderStructure}" Content="Preservar subpastas"/>
                    <CheckBox IsChecked="{Binding Settings.StripMetadata}" Content="Remover metadados"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="5">
                    <TextBlock Text="Originais e PDF" FontWeight="SemiBold"/>
                    <CheckBox IsChecked="{Binding Settings.DeleteOriginal}" Content="Excluir arquivo original"/>
                    <CheckBox IsChecked="{Binding Settings.OptimizePdfImages}" Content="Recomprimir imagens do PDF"/>
                    <TextBlock Text="O original é mantido por padrão." FontSize="11" Foreground="{DynamicResource BrandMutedText}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILA -->
        <Border Grid.Row="5" Classes="card" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,10">
                    <Button Content="➕ Adicionar Arquivos" Command="{Binding AddFilesCommand}" IsEnabled="{Binding CanModifyQueue}" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="📁 Adicionar Pasta" Command="{Binding AddFolderCommand}" IsEnabled="{Binding CanModifyQueue}"/>
                    <TextBlock Grid.Column="2" Text="{Binding QueueItems.Count, StringFormat='{}{0} item(ns)'}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="0,0,12,0" Foreground="{DynamicResource BrandMutedText}"/>
                    <Button Grid.Column="3" Content="🗑 Limpar Fila" Command="{Binding ClearQueueCommand}" IsEnabled="{Binding CanModifyQueue}"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Border IsVisible="{Binding !HasItems}" BorderBrush="#A9D8B4" BorderThickness="2" CornerRadius="8" Background="{DynamicResource BrandGreenSoft}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="📥" FontSize="38" HorizontalAlignment="Center"/>
                            <TextBlock Text="Arraste arquivos ou pastas aqui" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="PDF, JPG, PNG, BMP, TIFF, GIF e WebP" FontSize="12" Foreground="{DynamicResource BrandMutedText}"/>
                        </StackPanel>
                    </Border>
                    <Grid IsVisible="{Binding HasItems}" RowDefinitions="Auto,*">
                        <Border Background="{DynamicResource BrandSurfaceMuted}" CornerRadius="6" Padding="10,7">
                            <Grid ColumnDefinitions="*,120,120,100,130,42">
                                <TextBlock Text="Nome do arquivo" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="Original" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Saída" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Redução" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="Formato de saída" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ListBox Grid.Row="1" ItemsSource="{Binding QueueItems}" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate DataType="models:ImageQueueItem">
                                <Border Margin="0,2" Padding="10,8" CornerRadius="6" Background="{DynamicResource BrandSurfaceMuted}">
                                    <Grid ColumnDefinitions="*,120,120,100,130,42">
                                        <StackPanel><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource BrandMutedText}"/>
                                            <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="{DynamicResource BrandDanger}" IsVisible="{Binding IsError}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding OriginalSizeFormatted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding NewSizeFormatted}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding ReductionPercentage}" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource BrandGreenDark}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding OutputFormatDisplay}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <Button Grid.Column="5" Content="✕" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemoveItemCommand}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- RODAPÉ -->
        <Border Grid.Row="6" Classes="card">
            <Grid ColumnDefinitions="*,Auto,16,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding OverallProgress, StringFormat='{}{0:F0}%'}" FontWeight="Bold" IsVisible="{Binding IsProcessing}"/>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding OverallProgress}" Height="8" CornerRadius="4"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                    <TextBlock Text="Economia Total:" FontSize="11" Foreground="{DynamicResource BrandMutedText}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding TotalSavedFormatted}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrandGreenDark}"/>
                        <TextBlock Text="{Binding TotalReductionPercentage, StringFormat='({0})'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrandGreenDark}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <Button Content="{Binding StartProcessingButtonText}" Command="{Binding StartConversionCommand}" IsEnabled="{Binding CanStart}" IsVisible="{Binding !IsProcessing}" FontWeight="Bold" Padding="20,12" CornerRadius="8" FontSize="14"/>
                    <Button Content="{Binding ProcessingButtonText}" Command="{Binding CancelConversionCommand}" IsVisible="{Binding IsProcessing}" FontWeight="Bold" Padding="20,12" CornerRadius="8" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
